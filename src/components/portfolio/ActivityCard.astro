---
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';

// One card of an ActivityViewer: thumbnail, title and a meta line. Clicking it
// opens the viewer; the default slot holds the description shown there.

export interface Props extends HTMLAttributes<'li'> {
  title: string;
  meta?: string;
  /** Tags after the meta line, styled like the filter pills. */
  badges?: string[];
  cover?: string;
  /** Viewer URLs (see `viewerPhotos`). */
  photos?: string[];
  icon?: string;
}

const { title, meta, badges = [], cover, photos = [], icon = 'tabler:school', ...rest } = Astro.props;
---

<li data-item {...rest}>
  <button
    type="button"
    data-open
    data-photos={JSON.stringify(photos)}
    class="group/card block w-full rounded-lg text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
  >
    <span class="block aspect-[4/3] overflow-hidden rounded-lg bg-gray-100 dark:bg-slate-800">
      {
        cover ? (
          <Image
            class="h-full w-full object-cover transition group-hover/card:scale-[1.03]"
            widths={[320, 480]}
            sizes="(max-width: 639px) 50vw, (max-width: 1023px) 33vw, 260px"
            width={320}
            height={240}
            layout="cover"
            format="webp"
            src={cover}
            alt={title}
          />
        ) : (
          <span class="flex h-full items-center justify-center text-gray-400">
            <Icon name={icon} class="h-10 w-10" />
          </span>
        )
      }
    </span>
    <span data-title class="mt-2 block text-sm font-semibold leading-snug group-hover/card:text-primary">{title}</span>
    <span class="mt-1 flex flex-wrap items-center gap-1.5 text-xs text-muted">
      {meta}
      {
        badges.map((label) => (
          <span class="rounded-full border border-primary bg-primary/10 px-2 py-0.5 font-semibold text-primary dark:border-blue-300/50 dark:bg-slate-800 dark:text-blue-300">
            {label}
          </span>
        ))
      }
    </span>
  </button>
  <div data-description hidden>
    <slot />
  </div>
</li>
