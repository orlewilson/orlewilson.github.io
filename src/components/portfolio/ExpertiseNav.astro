---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { getPermalink } from '~/utils/permalinks';
import { expertise } from '~/data/expertise';

// Previous / next expertise links at the end of each expertise page. The
// order follows `expertise` and wraps around.

export interface Props {
  current: string;
}

const { current } = Astro.props;

const index = expertise.findIndex(({ slug }) => slug === current);
const at = (offset: number) => expertise[(index + offset + expertise.length) % expertise.length];

const links = [
  { area: at(-1), label: 'Eixo anterior', next: false },
  // On wider screens the "next" card mirrors the "previous" one: icon and text on the right.
  { area: at(1), label: 'Próximo eixo', next: true },
];
---

<WidgetWrapper containerClass="max-w-6xl mx-auto py-8 md:py-10 lg:py-12">
  <nav aria-label="Outros eixos de atuação" class="grid gap-4 sm:grid-cols-2">
    {
      links.map(({ area, label, next }) => (
        <a
          href={getPermalink(`/expertise/${area.slug}`)}
          class:list={[
            'group flex items-center gap-4 rounded-lg border border-gray-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-[0_8px_30px_rgba(0,0,0,0.12)] dark:border-slate-700 dark:bg-slate-900',
            next && 'sm:flex-row-reverse sm:text-right',
          ]}
        >
          <Icon name={area.colorIcon} class="h-12 w-12 shrink-0" />
          <span class="flex-1">
            <span
              class:list={[
                'flex items-center gap-1 text-sm font-semibold uppercase tracking-wider text-primary dark:text-blue-300',
                next && 'sm:justify-end',
              ]}
            >
              {!next && <Icon name="tabler:arrow-left" class="h-4 w-4" />}
              {label}
              {next && <Icon name="tabler:arrow-right" class="h-4 w-4" />}
            </span>
            <span class="mt-1 block text-lg font-bold group-hover:text-primary">{area.title}</span>
          </span>
        </a>
      ))
    }
  </nav>
</WidgetWrapper>
